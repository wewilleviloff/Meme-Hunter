# Application
BOT_MODE=PAPER
RUST_LOG=info
DATABASE_URL=sqlite://data/meme_hunter.db

# Crius (API key must include the `stream` scope)
CRIUS_API_KEY=
CRIUS_REST_BASE=https://api.crius.sh/v1/robinhood
CRIUS_WS_URL=wss://api.crius.sh/v1/robinhood/stream

# Robinhood Chain RPC (diagnose-quote only)
RPC_URL
# Telegram. Leave both empty to run without Telegram controls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Uniswap Trading API (diagnose-quote only).
UNISWAP_API_KEY=
UNISWAP_API_BASE=https://trade-api.gateway.uniswap.org/v1

# Strategy defaults
BUY_USD=10
TAKE_PROFIT_MULTIPLE=2.0
STOP_LOSS_PCT=35
MIN_LIQUIDITY_USD=10000
MIN_TOKEN_AGE_SECONDS=60
MAX_TOKEN_AGE_SECONDS=1800
MIN_SECURITY_SCORE=90
MAX_BUY_TAX_PCT=2
MAX_SELL_TAX_PCT=2
MIN_REALIZED_SELL_SAMPLES=3
MIN_HOLDERS=30
MAX_TOP10_HOLDER_PCT=55
MAX_DEV_HOLDER_PCT=5
MIN_VOLUME_5M_USD=500
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=5
MAX_DAILY_LOSS_USD=10

# Paper execution assumptions — calibrate against observed live quotes.
PAPER_BUY_FEE_PCT=1
PAPER_SELL_FEE_PCT=1
PAPER_GAS_USD_PER_SIDE=0.10
PRICE_POLL_SECONDS=20
