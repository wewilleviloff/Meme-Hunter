{
  "version": "2.0.0",
  "tasks": [
    { "label": "Cargo: check", "type": "shell", "command": "cargo check", "group": "build", "problemMatcher": ["$rustc"] },
    { "label": "Cargo: test", "type": "shell", "command": "cargo test", "group": "test", "problemMatcher": ["$rustc"] },
    { "label": "Cargo: run", "type": "shell", "command": "cargo run", "problemMatcher": ["$rustc"] },
    { "label": "Cargo: clippy", "type": "shell", "command": "cargo clippy --all-targets --all-features -- -D warnings", "problemMatcher": ["$rustc"] }
  ]
}
